RewriteEngine On
	# Put site in maintenance mode
	#RewriteCond %{REQUEST_URI} !=/maintenance.php
	#RewriteRule .* /maintenance.php
	
	# Disallow robots on the dev site
	RewriteCond %{HTTP_HOST} ^dev.specialtyproduce.com$ [NC]
	RewriteRule ^robots\.txt$ robots-dev.txt [NC,L]
	
	# Auto-Version .css and .js
	RewriteRule ^(.*)\.[\d]+\.(css|js)$    $1.$2 [NC,L]
